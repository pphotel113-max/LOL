--------------------------------------------------
--// FOLLOW ON / OFF
--------------------------------------------------

followButton.MouseButton1Click:Connect(function()

	if following then

		stopFollow()

		status.Text = "Đã dừng FOLLOW."

	else

		if selectedPlayer then

			startFollow()

			status.Text =
				"Đang bám theo "
				.. selectedPlayer.DisplayName

		else

			status.Text =
				"Hãy chọn người chơi trước."

		end
	end
end)

--------------------------------------------------
--// FOLLOW LOOP
--------------------------------------------------

RunService.Heartbeat:Connect(function()

	if following and selectedPlayer then

		if selectedPlayer.Parent ~= Players then

			selectedPlayer = nil
			stopFollow()
			status.Text = "Người chơi đã rời server."

			return
		end

		local myCharacter = LP.Character
		local targetCharacter = selectedPlayer.Character

		if myCharacter and targetCharacter then

			local myRoot =
				myCharacter:FindFirstChild("HumanoidRootPart")

			local targetRoot =
				targetCharacter:FindFirstChild("HumanoidRootPart")

			if myRoot and targetRoot then

				-- Luôn giữ vị trí phía sau
				myRoot.CFrame =
					targetRoot.CFrame * CFrame.new(0,0,4)

			end
		end
	end
end)

--------------------------------------------------
--// PLAYER JOIN
--------------------------------------------------

Players.PlayerAdded:Connect(function(player)

	player.CharacterAdded:Connect(function()

		task.wait(0.5)

		removeESP(player)

		if espEnabled then
			createESP(player)
		end
	end)

end)

--------------------------------------------------
--// PLAYER LEAVE
--------------------------------------------------

Players.PlayerRemoving:Connect(function(player)

	removeESP(player)

	if selectedPlayer == player then

		selectedPlayer = nil
		stopFollow()

		playerListFrame.Visible = false

		status.Text = "Người chơi đã rời server."
	end

end)

--------------------------------------------------
--// UPDATE LOOP
--------------------------------------------------

task.spawn(function()

	while gui.Parent do

		task.wait(0.1)

		if espEnabled then
			updateESP()
		end
	end
end)

--------------------------------------------------
--// PLAYER HIỆN TẠI
--------------------------------------------------

for _, player in ipairs(Players:GetPlayers()) do

	if player ~= LP then

		getmetatable(player)

		player.CharacterAdded:Connect(function()

			task.wait(0.5)

			removeESP(player)

			if espEnabled then
				createESP(player)
			end
		end)
	end
end
