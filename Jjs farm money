--// SPEED
local speedEnabled = false

speedButton.MouseButton1Click:Connect(function()

	speedEnabled = not speedEnabled

	local character = LP.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if speedEnabled then
		speedButton.Text = "🏃 SPEED: ON"

		if humanoid then
			humanoid.WalkSpeed = WALK_SPEED
		end
	else
		speedButton.Text = "🏃 SPEED: OFF"

		if humanoid then
			humanoid.WalkSpeed = 16
		end
	end
end)

--// TELEPORT ALL
local teleporting = false

local function teleportBehind(player)

	local char = LP.Character
	local target = player.Character

	if not char or not target then
		return
	end

	local root = char:FindFirstChild("HumanoidRootPart")
	local targetRoot = target:FindFirstChild("HumanoidRootPart")

	if root and targetRoot then
		root.CFrame =
			targetRoot.CFrame *
			CFrame.new(0,0,TELEPORT_DISTANCE)
	end
end

tpButton.MouseButton1Click:Connect(function()

	teleporting = not teleporting

	if teleporting then

		tpButton.Text = "🔄 TELEPORT ALL: ON"

		task.spawn(function()

			while teleporting do

				for _,player in ipairs(Players:GetPlayers()) do

					if not teleporting then
						break
					end

					if player ~= LP then
						teleportBehind(player)
						task.wait(TELEPORT_DELAY)
					end

				end

			end

		end)

	else
		tpButton.Text = "🔄 TELEPORT ALL: OFF"
	end
end)

--// NOCLIP
local noclipEnabled = false
local noclipConnection

local function setNoclip(character, enabled)

	for _,obj in ipairs(character:GetDescendants()) do
		if obj:IsA("BasePart") then
			obj.CanCollide = not enabled
		end
	end
end

noclipButton.MouseButton1Click:Connect(function()

	noclipEnabled = not noclipEnabled

	if noclipEnabled then

		noclipButton.Text = "👻 NOCLIP: ON"

		noclipConnection = RunService.Stepped:Connect(function()

			local character = LP.Character

			if character then
				setNoclip(character,true)
			end

		end)

	else
		noclipButton.Text = "👻 NOCLIP: OFF"

		if noclipConnection then
			noclipConnection:Disconnect()
			noclipConnection = nil
		end

		local character = LP.Character

		if character then
			setNoclip(character,false)
		end
	end
end)

--// GIỮ SPEED SAU RESPAWN
LP.CharacterAdded:Connect(function(character)

	local humanoid = character:WaitForChild("Humanoid")

	if speedEnabled then
		humanoid.WalkSpeed = WALK_SPEED
	end

	if noclipEnabled then
		task.wait(0.2)
		setNoclip(character,true)
	end

end)
